# Địa chỉ portal mà máy chạy agent gọi tới được (IP public / domain / qua VPN)
MONITOR_SERVER=https://monitor.congty.vn:3443

# API key vai trò "collector" (tạo ở portal: Cài đặt → vCenter → Thêm collector cho site ở xa). Tên collector = tên key.
MONITOR_TOKEN=vmk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 1 = bỏ kiểm tra chứng chỉ HTTPS của portal (khi portal dùng chứng chỉ tự ký). Chứng chỉ thật thì để 0.
MONITOR_INSECURE=0

# Múi giờ hiển thị trong log
TZ=Asia/Ho_Chi_Minh
