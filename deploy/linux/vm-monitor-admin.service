[Unit]
Description=VM Monitor - web admin (quản trị + nhân viên, nhận số liệu từ agent)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vmmonitor
Group=vmmonitor
WorkingDirectory=/var/lib/vm-monitor
Environment=TZ=Asia/Ho_Chi_Minh
EnvironmentFile=-/etc/vm-monitor/admin.env
# /var/lib/vm-monitor chứa config.json, data/ (lịch sử, khoá, báo cáo, nhật ký), backups/
ExecStart=/usr/bin/java -XX:MaxRAMPercentage=70 -jar /opt/vm-monitor/vm-monitor-admin.jar --root /var/lib/vm-monitor --log-file /var/lib/vm-monitor/data/portal.log $ADMIN_ARGS
Restart=always
RestartSec=5
SuccessExitStatus=143
# bảo vệ hệ thống
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/vm-monitor

[Install]
WantedBy=multi-user.target
