        "label": "Khách hàng",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(vm_up{site=~\"$site\"}, customer)",
          "refId": "customer"
        },
        "definition": "label_values(vm_up{site=~\"$site\"}, customer)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
