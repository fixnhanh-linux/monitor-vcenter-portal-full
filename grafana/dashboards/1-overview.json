{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus đang scrape /metrics của VM Monitor Portal",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "9.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "title": "VM Monitor · 1. Tổng quan",
  "uid": "vm-monitor-overview",
  "tags": [
    "vm-monitor"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "title": "VM Monitor",
      "type": "dashboards",
      "tags": [
        "vm-monitor"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "site",
        "label": "Site",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(vm_up, site)",
          "refId": "site"
        },
        "definition": "label_values(vm_up, site)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "customer",
        "label": "Khách hàng",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(vm_up{site=~\"$site\"}, customer)",
          "refId": "customer"
        },
        "definition": "label_values(vm_up{site=~\"$site\"}, customer)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(vmhost_up{site=~\"$site\"}, cluster)",
          "refId": "cluster"
        },
        "definition": "label_values(vmhost_up{site=~\"$site\"}, cluster)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "esxi",
        "label": "Host ESXi",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(vmhost_up{site=~\"$site\", cluster=~\"$cluster\"}, host)",
          "refId": "esxi"
        },
        "definition": "label_values(vmhost_up{site=~\"$site\", cluster=~\"$cluster\"}, host)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "groupby",
        "label": "Nhóm theo",
        "type": "custom",
        "query": "Site : site, Khách hàng : customer, Cluster : cluster, Host ESXi : host, VM : vm",
        "options": [
          {
            "text": "Site",
            "value": "site",
            "selected": true
          },
          {
            "text": "Khách hàng",
            "value": "customer",
            "selected": false
          },
          {
            "text": "Cluster",
            "value": "cluster",
            "selected": false
          },
          {
            "text": "Host ESXi",
            "value": "host",
            "selected": false
          },
          {
            "text": "VM",
            "value": "vm",
            "selected": false
          }
        ],
        "current": {
          "text": "Site",
          "value": "site"
        },
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Tình trạng",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "VM online",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(vm_up{site=~\"$site\", customer=~\"$customer\", cluster=~\"$cluster\", host=~\"$esxi\", vm=~\"(?i).*${q:regex}.*\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
