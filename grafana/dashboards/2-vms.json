{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus đang scrape /metrics của VM Monitor Portal",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "9.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "title": "VM Monitor · 2. VM",
  "uid": "vm-monitor-vms",
  "tags": [
    "vm-monitor"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "title": "VM Monitor",
      "type": "dashboards",
      "tags": [
        "vm-monitor"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "site",
        "label": "Site",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(vm_up, site)",
          "refId": "site"
        },
        "definition": "label_values(vm_up, site)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "customer",
        "label": "Khách hàng",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(vm_up{site=~\"$site\"}, customer)",
          "refId": "customer"
        },
        "definition": "label_values(vm_up{site=~\"$site\"}, customer)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(vmhost_up{site=~\"$site\"}, cluster)",
          "refId": "cluster"
        },
        "definition": "label_values(vmhost_up{site=~\"$site\"}, cluster)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "esxi",
        "label": "Host ESXi",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(vmhost_up{site=~\"$site\", cluster=~\"$cluster\"}, host)",
          "refId": "esxi"
        },
        "definition": "label_values(vmhost_up{site=~\"$site\", cluster=~\"$cluster\"}, host)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "q",
        "label": "Tìm tên VM",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      },
      {
        "name": "vm",
        "label": "VM (chi tiết)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(vm_up{site=~\"$site\", customer=~\"$customer\", cluster=~\"$cluster\", host=~\"$esxi\", vm=~\"(?i).*${q:regex}.*\"}, vm)",
          "refId": "vm"
        },
        "definition": "label_values(vm_up{site=~\"$site\", customer=~\"$customer\", cluster=~\"$cluster\", host=~\"$esxi\", vm=~\"(?i).*${q:regex}.*\"}, vm)",
        "includeAll": false,
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Danh sách VM (lọc bằng các ô phía trên, bấm tiêu đề cột để sắp xếp)",
