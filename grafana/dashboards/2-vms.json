            "renameByName": {
              "Value #A": "CPU %",
              "Value #B": "RAM %",
              "Value #C": "Disk %",
              "Value #D": "RAM",
              "Value #E": "Net in",
              "Value #F": "Net out",
              "Value #G": "Cảnh báo",
              "Value #H": "Online",
              "site": "Site",
              "vm": "VM",
              "customer": "Khách hàng",
              "cluster": "Cluster",
              "host": "Host ESXi",
              "ip": "IP",
              "datastore": "Datastore",
              "type": "Loại"
            }
          }
        }
